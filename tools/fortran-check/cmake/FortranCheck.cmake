include_guard(GLOBAL)

function(fortran_check_enable)
    cmake_parse_arguments(PARSE_ARGV 0 CHECK "" "EXECUTABLE;ROOT;PROFILE;CONFIG;REPORTS_DIR;FORTITUDE" "")
    if(CHECK_UNPARSED_ARGUMENTS OR CHECK_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid arguments for fortran_check_enable")
    endif()
    if(CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_GENERATOR MATCHES "^(Ninja|.*Makefiles)$")
        message(FATAL_ERROR "FortranCheck requires single-configuration Ninja or a Makefiles generator")
    endif()
    if(NOT CMAKE_Fortran_COMPILER_ID MATCHES "^(GNU|IntelLLVM)$")
        message(FATAL_ERROR "FortranCheck supports gfortran and ifx, found '${CMAKE_Fortran_COMPILER_ID}'")
    endif()
    if(TARGET fortran_check)
        message(FATAL_ERROR "FortranCheck is already enabled in this project")
    endif()
    if(NOT CHECK_EXECUTABLE)
        find_program(FORTRAN_CHECK_EXECUTABLE NAMES fortran-check REQUIRED)
        set(CHECK_EXECUTABLE "${FORTRAN_CHECK_EXECUTABLE}")
    else()
        get_filename_component(CHECK_EXECUTABLE "${CHECK_EXECUTABLE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    endif()
    if(NOT CHECK_ROOT)
        set(CHECK_ROOT "${PROJECT_SOURCE_DIR}")
    endif()
    get_filename_component(CHECK_ROOT "${CHECK_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT CHECK_PROFILE)
        set(CHECK_PROFILE generic)
    endif()
    if(NOT CHECK_REPORTS_DIR)
        set(CHECK_REPORTS_DIR "${PROJECT_BINARY_DIR}/fortran-check")
    endif()
    get_filename_component(CHECK_REPORTS_DIR "${CHECK_REPORTS_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    set(_gate "${CHECK_REPORTS_DIR}/gate.json")

    set(_policy --root "${CHECK_ROOT}" --profile "${CHECK_PROFILE}")
    if(CHECK_CONFIG)
        get_filename_component(CHECK_CONFIG "${CHECK_CONFIG}" ABSOLUTE BASE_DIR "${CHECK_ROOT}")
        list(APPEND _policy --config "${CHECK_CONFIG}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CHECK_CONFIG}")
    endif()
    set(_compiler --compiler-id "${CMAKE_Fortran_COMPILER_ID}")
    if(WIN32)
        set(_host --windows)
    endif()
    execute_process(
        COMMAND "${CHECK_EXECUTABLE}" compiler-flags ${_policy} ${_compiler} ${_host} --format json
        RESULT_VARIABLE _status
        OUTPUT_VARIABLE _flags
        ERROR_VARIABLE _error
    )
    if(NOT _status STREQUAL "0")
        message(FATAL_ERROR "Cannot load FortranCheck compiler options (${_status})\n${_error}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CHECK_EXECUTABLE}")
    string(JSON _flag_count LENGTH "${_flags}")
    set(_compile_options "")
    if(_flag_count GREATER 0)
        math(EXPR _last_flag "${_flag_count} - 1")
        foreach(_index RANGE "${_last_flag}")
            string(JSON _flag GET "${_flags}" "${_index}")
            string(REPLACE "'" "'\"'\"'" _quoted "${_flag}")
            string(APPEND _compile_options " '${_quoted}'")
        endforeach()
        add_compile_options("$<$<COMPILE_LANGUAGE:Fortran>:SHELL:${_compile_options}>")
    endif()

    set(_runtime)
    if(CHECK_FORTITUDE)
        list(APPEND _runtime --fortitude "${CHECK_FORTITUDE}")
    endif()
    add_custom_target(fortran_check ALL
        COMMAND "${CHECK_EXECUTABLE}" check ${_policy} ${_compiler} ${_runtime}
            --compile-db "${CMAKE_BINARY_DIR}/compile_commands.json"
            --reports-dir "${CHECK_REPORTS_DIR}" --gate "${_gate}"
        BYPRODUCTS "${_gate}"
        COMMENT "Checking Fortran project"
        VERBATIM
    )
    set(CMAKE_EXPORT_COMPILE_COMMANDS ON PARENT_SCOPE)
    set(CMAKE_Fortran_PREPROCESS ON PARENT_SCOPE)
    set(_launcher "${CHECK_EXECUTABLE}" launch --gate "${_gate}" --)
    list(APPEND _launcher ${CMAKE_Fortran_COMPILER_LAUNCHER})
    set(CMAKE_Fortran_COMPILER_LAUNCHER "${_launcher}" PARENT_SCOPE)
endfunction()

function(_fortran_check_collect_targets directory output)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    set(_compiling)
    foreach(_target IN LISTS _targets)
        get_target_property(_type "${_target}" TYPE)
        if(_type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
            list(APPEND _compiling "${_target}")
        endif()
    endforeach()
    get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        _fortran_check_collect_targets("${_child}" _child_targets)
        list(APPEND _compiling ${_child_targets})
    endforeach()
    set(${output} "${_compiling}" PARENT_SCOPE)
endfunction()

function(fortran_check_add_target)
    cmake_parse_arguments(PARSE_ARGV 0 CHECK "" "" "TARGETS;GENERATED_TARGETS")
    if(CHECK_UNPARSED_ARGUMENTS OR CHECK_KEYWORDS_MISSING_VALUES OR NOT TARGET fortran_check)
        message(FATAL_ERROR "Call fortran_check_enable before fortran_check_add_target")
    endif()
    if(CHECK_GENERATED_TARGETS)
        add_dependencies(fortran_check ${CHECK_GENERATED_TARGETS})
    endif()
    if(NOT CHECK_TARGETS)
        _fortran_check_collect_targets("${CMAKE_CURRENT_SOURCE_DIR}" CHECK_TARGETS)
    endif()
    foreach(_target IN LISTS CHECK_TARGETS)
        add_dependencies("${_target}" fortran_check)
    endforeach()
endfunction()
