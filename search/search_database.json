u , dv , v ) call combine_phi ( v ) call self % project_properties ( T , vapor , vapor_state , v ) vapor_state % p = p end if return end if damping = 1 d0 if ( sl < 0 d0 ) damping = min ( damping , 0.5d0 * ( dl - 1 d0 ) / ( - sl )) if ( sv > 0 d0 ) damping = min ( damping , 0.5d0 * ( 1 d0 - dv ) / sv ) if ( sv < 0 d0 ) damping = min ( damping , 0.5d0 * dv / ( - sv )) dl = dl + damping * sl dv = dv + damping * sv end do end subroutine saturation_densities_iapws95 module pure elemental subroutine calc_phi_iapws95 ( self , tau , delta , property ) implicit none !> IAPWS-95 model instance class ( type_iapws95 ), intent ( in ) :: self !> Inverse reduced temperature Tc/T, [-] real ( real64 ), intent ( in ) :: tau !> Reduced density ρ/rho_c, [-] real ( real64 ), intent ( in ) :: delta !> IAPWS-95 helmholtz properties type ( type_iapws_helmholtz_property ), intent ( inout ) :: property call self % calc_phi0 ( tau , delta , property ) call self % calc_phir ( tau , delta , property ) call combine_phi ( property ) end subroutine calc_phi_iapws95 pure subroutine combine_phi ( property ) implicit none type ( type_iapws_helmholtz_property ), intent ( inout ) :: property property % f = property % f0 + property % fr property % f_d = property % f0_d + property % fr_d property % f_t = property % f0_t + property % fr_t property % f_dd = property % f0_dd + property % fr_dd property % f_tt = property % f0_tt + property % fr_tt property % f_dt = property % f0_dt + property % fr_dt end subroutine combine_phi module pure elemental subroutine calc_phi0_iapws95 ( self , tau , delta , property ) implicit none !> IAPWS-95 model instance class ( type_iapws95 ), intent ( in ) :: self !> Inverse reduced temperature Tc/T, [-] real ( real64 ), intent ( in ) :: tau !> Reduced density ρ/rho_c, [-] real ( real64 ), intent ( in ) :: delta !> IAPWS-95 ideal helmholtz properties type ( type_iapws_helmholtz_property ), intent ( inout ) :: property ! Local variables integer ( int32 ) :: i integer ( int32 ) :: pow_i real ( real64 ) :: t_val , n_val , g_val real ( real64 ) :: exp_gtau , one_minus_exp , inv_one_minus_exp , q , logq real ( real64 ), parameter :: ext = 0.278296458178592d0 , tau_e = critical_temperature / 130 d0 ! Initialize properties property % f0 = 0.0d0 property % f0_t = 0.0d0 property % f0_tt = 0.0d0 property % f0_d = 0.0d0 property % f0_dd = 0.0d0 property % f0_dt = 0.0d0 ! Base ideal gas terms (using direct assignment for initial values) property % f0 = n0_log ( 1 ) * log ( delta ) + n0_log ( 2 ) * log ( tau ) property % f0_t = n0_log ( 2 ) / tau property % f0_tt = - n0_log ( 2 ) / tau ** 2 property % f0_d = 1.0d0 / delta property % f0_dd = - 1.0d0 / delta ** 2 property % f0_dt = 0.0d0 ! Loop 1: Power terms do i = 1 , size ( pow ) pow_i = pow ( i ) t_val = real ( pow_i , real64 ) n_val = n0_pow ( i ) property % f0 = property % f0 + n_val * ( tau ** t_val ) if ( pow_i /= 0 ) then property % f0_t = property % f0_t + t_val * n_val * ( tau ** ( pow_i - 1 )) end if if ( pow_i /= 0 . and . pow_i /= 1 ) then property % f0_tt = property % f0_tt + n_val * t_val * ( t_val - 1.0d0 ) * ( tau ** ( pow_i - 2 )) end if end do ! Loop 2: Exponential terms do i = 1 , size ( n0_exp ) n_val = n0_exp ( i ) g_val = g0 ( i ) exp_gtau = exp ( - g_val * tau ) one_minus_exp = 1.0d0 - exp_gtau inv_one_minus_exp = 1.0d0 / one_minus_exp property % f0 = property % f0 + n_val * log ( one_minus_exp ) property % f0_t = property % f0_t + n_val * g_val * ( inv_one_minus_exp - 1.0d0 ) property % f0_tt = property % f0_tt + - n_val * g_val ** 2 * exp_gtau * ( inv_one_minus_exp ** 2 ) end do ! G9-12: integrated ideal-part correction, with zero value and slope at 130 K. if ( tau > tau_e . and . tau <= critical_temperature / 50 d0 ) then q = tau / tau_e logq = log ( q ) property % f0 = property % f0 + ext / tau_e * & ( 0.5d0 * q ** 2 + 4.5d0 * ( q - 1 d0 ) - 3 d0 * ( q + 1 d0 ) * logq - 0.5d0 / q ) property % f0_t = property % f0_t + ext / tau_e ** 2 * & ( q - 3 d0 * logq - 3 d0 / q + 0.5d0 / q ** 2 + 1.5d0 ) property % f0_tt = property % f0_tt + ext * ( 1 d0 / tau_e - 1 d0 / tau ) ** 3 end if end subroutine calc_phi0_iapws95 module pure elemental subroutine calc_phir_iapws95 ( self , tau , delta , property ) implicit none !> IAPWS-95 model instance class ( type_iapws95 ), intent ( in ) :: self !> Inverse reduced temperature Tc/T, [-] real ( real64 ), intent ( in ) :: tau !> Reduced density ρ/rho_c, [-] real ( real64 ), intent ( in ) :: delta !> IAPWS-95 residual helmholtz properties (phi and derivatives) type ( type_iapws_helmholtz_property ), intent ( inout ) :: property ! --- Loop variables --- integer ( int32 ) :: i , k ! --- Pre-computed power tables --- real ( real64 ) :: powers_delta ( 0 : DELTA_POW_MAX ) real ( real64 ) :: powers_tau_int ( 0 : TAU_INT_POW_MAX ) ! --- Helper variables for optimization --- real ( real64 ) :: inv_delta , inv_tau , inv_delta_sq , inv_tau_sq real ( real64 ) :: delta_sq , tau_sq real ( real64 ) :: bi , term_d , term_t ! --- Polynomial & Exponential terms vars --- real ( real64 ) :: d_val , t_val , nr_val , c_val , g_val real ( real64 ) :: delta_pow_c , exp_val real ( real64 ) :: Q , R_val ! --- Gaussian terms vars --- real ( real64 ) :: alfa_val , beta_val , gamma_val , eps_val real ( real64 ) :: delta_diff , tau_diff , sq_delta_diff , sq_tau_diff real ( real64 ) :: exp_arg ! --- Non-Analytic terms vars --- real ( real64 ) :: a_val , b_val , BB_val , AA_val , beta4_val real ( real64 ) :: c_int_val , D_int_val real ( real64 ) :: diff_d , diff_t , sq_diff_d , sq_diff_t real ( real64 ) :: theta , delta_term , psi real ( real64 ) :: pow_theta real ( real64 ) :: d_theta_d , d_psi_d , d_psi_t real ( real64 ) :: d2_theta_dd , d2_psi_dd , d2_psi_tt , d2_psi_dt real ( real64 ) :: d_Delta_d , d_Delta_t , d2_Delta_dd , d2_Delta_tt , d2_Delta_dt real ( real64 ) :: d_Delta_pow_b_d , d_Delta_pow_b_t real ( real64 ) :: d2_Delta_pow_b_dd , d2_Delta_pow_b_tt , d2_Delta_pow_b_dt ! --- Initialization --- property % fr = 0.0d0 property % fr_d = 0.0d0 property % fr_t = 0.0d0 property % fr_dd = 0.0d0 property % fr_tt = 0.0d0 property % fr_dt = 0.0d0 ! Pre-calculate inverses and squares inv_delta = 1.0d0 / delta inv_tau = 1.0d0 / tau inv_delta_sq = inv_delta * inv_delta inv_tau_sq = inv_tau * inv_tau delta_sq = delta * delta tau_sq = tau * tau ! Build power table for delta: indices 0..15 powers_delta ( 0 ) = 1.0d0 powers_delta ( 1 ) = delta do k = 2 , DELTA_POW_MAX powers_delta ( k ) = powers_delta ( k - 1 ) * delta end do ! Build power table for tau (integer exponents): indices 0..50 powers_tau_int ( 0 ) = 1.0d0 powers_tau_int ( 1 ) = tau do k = 2 , TAU_INT_POW_MAX powers_tau_int ( k ) = powers_tau_int ( k - 1 ) * tau end do ! ================================================================== ! 1. Polynomial Terms (Terms 1-7) !    phi = n * delta&#94;d * tau&#94;t !    Note: t1 contains non-integer exponents, so tau**t_val !    cannot use the integer power table. ! ================================================================== Polynomial : do i = 1 , size ( nr1 ) nr_val = nr1 ( i ) d_val = real ( d1 ( i ), real64 ) t_val = t1 ( i ) ! Base term: use power table for delta, keep tau**t_val as-is bi = nr_val * powers_delta ( d1 ( i )) * ( tau ** t_val ) property % fr = property % fr + bi ! Derivatives property % fr_d = property % fr_d + bi * ( d_val * inv_delta ) property % fr_t = property % fr_t + bi * ( t_val * inv_tau ) property % fr_dd = property % fr_dd + bi * ( d_val * ( d_val - 1.0d0 ) * inv_delta_sq ) property % fr_tt = property % fr_tt + bi * ( t_val * ( t_val - 1.0d0 ) * inv_tau_sq ) property % fr_dt = property % fr_dt + bi * ( d_val * t_val * inv_delta * inv_tau ) end do Polynomial ! ================================================================== ! 2. Exponential Terms (Terms 8-51) !    phi = n * delta&#94;d * tau&#94;t * exp(-g * delta&#94;c) !    All exponents d2, t2, c2 are integer => use power tables. ! ================================================================== Exponential : do i = 1 , size ( nr2 ) nr_val = nr2 ( i ) d_val = real ( d2 ( i ), real64 ) t_val = real ( t2 ( i ), real64 ) c_val = real ( c2 ( i ), real64 ) g_val = real ( gamma2 ( i ), real64 ) ! Common subexpressions using power tables delta_pow_c = powers_delta ( c2 ( i )) exp_val = exp ( - g_val * delta_pow_c ) bi = nr_val * powers_delta ( d2 ( i )) * powers_tau_int ( t2 ( i )) * exp_val ! Derivative helpers Q = d_val - c_val * g_val * delta_pow_c R_val = ( c_val ** 2 ) * g_val * delta_pow_c property % fr = property % fr + bi property % fr_d = property % fr_d + bi * ( Q * inv_delta ) property % fr_t = property % fr_t + bi * ( t_val * inv_tau ) property % fr_dd = property % fr_dd + bi * (( Q ** 2 - Q - R_val ) * inv_delta_sq ) property % fr_tt = property % fr_tt + bi * ( t_val * ( t_val - 1.0d0 ) * inv_tau_sq ) property % fr_dt = property % fr_dt + bi * ( t_val * Q * inv_delta * inv_tau ) end do Exponential ! ================================================================== ! 3. Gaussian Terms (Terms 52-54) !    phi = n * delta&#94;d * tau&#94;t * exp[ -alpha*(delta-epsilon)&#94;2 - beta*(tau-gamma)&#94;2 ] !    d3 and t3 are integer => use power tables. ! ================================================================== Gaussian : do i = 1 , size ( nr3 ) nr_val = nr3 ( i ) d_val = real ( d3 ( i ), real64 ) t_val = real ( t3 ( i ), real64 ) alfa_val = alfa3 ( i ) beta_val = beta3 ( i ) gamma_val = gamma3 ( i ) eps_val = epsilon3 ( i ) delta_diff = delta - eps_val tau_diff = tau - gamma_val sq_delta_diff = delta_diff * delta_diff sq_tau_diff = tau_diff * tau_diff exp_arg = - alfa_val * sq_delta_diff - beta_val * sq_tau_diff exp_val = exp ( exp_arg ) bi = nr_val * powers_delta ( d3 ( i )) * powers_tau_int ( t3 ( i )) * exp_val ! Derivative helpers term_d = ( d_val * inv_delta ) - 2.0d0 * alfa_val * delta_diff term_t = ( t_val * inv_tau ) - 2.0d0 * beta_val * tau_diff property % fr = property % fr + bi property % fr_d = property % fr_d + bi * term_d property % fr_t = property % fr_t + bi * term_t property % fr_dd = property % fr_dd + bi * ( term_d ** 2 - ( d_val * inv_delta_sq ) - 2.0d0 * alfa_val ) property % fr_tt = property % fr_tt + bi * ( term_t ** 2 - ( t_val * inv_tau_sq ) - 2.0d0 * beta_val ) property % fr_dt = property % fr_dt + bi * ( term_d * term_t ) end do Gaussian ! ================================================================== ! 4. Non-Analytic Terms (Terms 55-56) !    phi = n * delta * Delta&#94;b * Psi !    Uses real-valued exponents => cannot use integer power tables. ! ================================================================== NonAnalitic : do i = 1 , size ( nr4 ) nr_val = nr4 ( i ) a_val = a4 ( i ) b_val = b4 ( i ) BB_val = B ( i ) c_int_val = real ( C ( i ), real64 ) D_int_val = real ( D ( i ), real64 ) AA_val = A ( i ) beta4_val = beta4 ( i ) diff_d = delta - 1.0d0 diff_t = tau - 1.0d0 sq_diff_d = diff_d * diff_d sq_diff_t = diff_t * diff_t ! Theta pow_theta = 1.0d0 / ( 2.0d0 * beta4_val ) theta = ( 1.0d0 - tau ) + AA_val * ( sq_diff_d ** pow_theta ) ! Delta (delta_term) delta_term = theta ** 2 + BB_val * ( sq_diff_d ** a_val ) ! Psi psi = exp ( - c_int_val * sq_diff_d - D_int_val * sq_diff_t ) ! Base phi bi = nr_val * delta * ( delta_term ** b_val ) * psi property % fr = property % fr + bi ! --- Derivatives of Components --- ! d(Theta)/d(delta) d_theta_d = AA_val * ( 1.0d0 / beta4_val ) * diff_d * ( sq_diff_d ** ( pow_theta - 1.0d0 )) ! d2(Theta)/d(delta)&#94;2 ! This combined power has a finite zero limit at the critical density. d2_theta_dd = AA_val / beta4_val * ( 2.0d0 * pow_theta - 1.0d0 ) * & sq_diff_d ** ( pow_theta - 1.0d0 ) ! d(Psi)/d(delta), d(Psi)/d(tau) d_psi_d = psi * ( - 2.0d0 * c_int_val * diff_d ) d_psi_t = psi * ( - 2.0d0 * D_int_val * diff_t ) ! d2(Psi) d2_psi_dd = d_psi_d * ( - 2.0d0 * c_int_val * diff_d ) + psi * ( - 2.0d0 * c_int_val ) d2_psi_tt = d_psi_t * ( - 2.0d0 * D_int_val * diff_t ) + psi * ( - 2.0d0 * D_int_val ) d2_psi_dt = d_psi_d * ( - 2.0d0 * D_int_val * diff_t ) ! d(Delta) d_Delta_d = 2.0d0 * theta * d_theta_d + & 2.0d0 * BB_val * a_val * diff_d * ( sq_diff_d ** ( a_val - 1.0d0 )) ! d(Delta)/dt = 2*Theta*(-1) d_Delta_t = - 2.0d0 * theta ! d2(Delta) d2_Delta_dd = 2.0d0 * ( d_theta_d ** 2 + theta * d2_theta_dd ) + & 2.0d0 * BB_val * a_val * ( sq_diff_d ** ( a_val - 1.0d0 )) + & 4.0d0 * BB_val * a_val * ( a_val - 1.0d0 ) * sq_diff_d * ( sq_diff_d ** ( a_val - 2.0d0 )) d2_Delta_tt = 2.0d0 ! (-1 * -1 * 2) d2_Delta_dt = - 2.0d0 * d_theta_d ! d(Delta&#94;b) if ( delta_term > 0.0d0 ) then d_Delta_pow_b_d = b_val * ( delta_term ** ( b_val - 1.0d0 )) * d_Delta_d d_Delta_pow_b_t = b_val * ( delta_term ** ( b_val - 1.0d0 )) * d_Delta_t ! d2(Delta&#94;b) terms d2_Delta_pow_b_dd = b_val * (( b_val - 1.0d0 ) * ( delta_term ** ( b_val - 2.0d0 )) * d_Delta_d ** 2 + & ( delta_term ** ( b_val - 1.0d0 )) * d2_Delta_dd ) d2_Delta_pow_b_tt = b_val * (( b_val - 1.0d0 ) * ( delta_term ** ( b_val - 2.0d0 )) * d_Delta_t ** 2 + & ( delta_term ** ( b_val - 1.0d0 )) * d2_Delta_tt ) d2_Delta_pow_b_dt = b_val * (( b_val - 1.0d0 ) * ( delta_term ** ( b_val - 2.0d0 )) * d_Delta_d * d_Delta_t + & ( delta_term ** ( b_val - 1.0d0 )) * d2_Delta_dt ) else d_Delta_pow_b_d = 0.0d0 d_Delta_pow_b_t = 0.0d0 d2_Delta_pow_b_dd = 0.0d0 d2_Delta_pow_b_tt = 0.0d0 d2_Delta_pow_b_dt = 0.0d0 end if ! --- Assembly of Derivatives --- ! phi_d property % fr_d = property % fr_d + & ( bi * inv_delta ) + & nr_val * delta * d_Delta_pow_b_d * psi + & bi * ( - 2.0d0 * c_int_val * diff_d ) ! phi_t property % fr_t = property % fr_t + & nr_val * delta * d_Delta_pow_b_t * psi + & bi * ( - 2.0d0 * D_int_val * diff_t ) ! phi_dd property % fr_dd = property % fr_dd + & nr_val * ( & 2.0d0 * d_Delta_pow_b_d * psi + & 2.0d0 * ( delta_term ** b_val ) * d_psi_d + & delta * d2_Delta_pow_b_dd * psi + & 2.0d0 * delta * d_Delta_pow_b_d * d_psi_d + & delta * ( delta_term ** b_val ) * d2_psi_dd & ) ! phi_tt property % fr_tt = property % fr_tt + & nr_val * delta * ( & d2_Delta_pow_b_tt * psi + & 2.0d0 * d_Delta_pow_b_t * d_psi_t + & ( delta_term ** b_val ) * d2_psi_tt & ) ! phi_dt property % fr_dt = property % fr_dt + & nr_val * ( & d_Delta_pow_b_t * psi + & ( delta_term ** b_val ) * d_psi_t + & delta * ( & d2_Delta_pow_b_dt * psi + & d_Delta_pow_b_d * d_psi_t + & d_Delta_pow_b_t * d_psi_d + & ( delta_term ** b_val ) * d2_psi_dt & ) & ) end do NonAnalitic end subroutine calc_phir_iapws95 end submodule iapws95_base","tags":"","url":"sourcefile/iapws95_base.f90.html"},{"title":"iapws97_region4.F90 – IAPWS","text":"This file depends on sourcefile~~iapws97_region4.f90~~EfferentGraph sourcefile~iapws97_region4.f90 iapws97_region4.F90 sourcefile~iapws97_interface.f90 iapws97_interface.F90 sourcefile~iapws97_region4.f90->sourcefile~iapws97_interface.f90 sourcefile~iapws_interface.f90 iapws_interface.F90 sourcefile~iapws97_interface.f90->sourcefile~iapws_interface.f90 sourcefile~batch_support.f90 batch_support.F90 sourcefile~iapws_interface.f90->sourcefile~batch_support.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code submodule ( module_iapws97 ) iapws97_region4 implicit none !------------------------------------------------------------------------------------------ ! Region4: Saturation curve between liquid and vapor (IAPWS-IF97) !------------------------------------------------------------------------------------------ integer ( int32 ), parameter :: N4_terms = 10 real ( real64 ), parameter :: n_r4 ( N4_terms ) = [ & 0.11670521452767d4 , - 0.72421316703206d6 , - 0.17073846940092d2 , & 0.12020824702470d5 , - 0.32325550322333d7 , 0.14915108613530d2 , & - 0.48232657361591d4 , 0.40511340542057d6 , - 0.23855557567849d0 , & 0.65017534844798d3 ] contains !> Analytic slope of Eq. 30, in Pa/K. module pure elemental function calc_dpsat_dT_iapws97_region4 ( self , temperature ) result ( slope ) implicit none class ( type_iapws97_region4 ), intent ( in ) :: self real ( real64 ), intent ( in ) :: temperature real ( real64 ) :: slope real ( real64 ) :: theta , theta_T , a , b , c , at , bt , ct , disc , denom , denom_T , beta theta = calc_vartheta_iapws97_region4 ( temperature , self % T_star ) theta_T = ( 1 d0 - n_r4 ( 9 ) / ( temperature / self % T_star - n_r4 ( 10 )) ** 2 ) / self % T_star a = theta ** 2 + n_r4 ( 1 ) * theta + n_r4 ( 2 ) b = n_r4 ( 3 ) * theta ** 2 + n_r4 ( 4 ) * theta + n_r4 ( 5 ) c = n_r4 ( 6 ) * theta ** 2 + n_r4 ( 7 ) * theta + n_r4 ( 8 ) at = ( 2 d0 * theta + n_r4 ( 1 )) * theta_T bt = ( 2 d0 * n_r4 ( 3 ) * theta + n_r4 ( 4 )) * theta_T ct = ( 2 d0 * n_r4 ( 6 ) * theta + n_r4 ( 7 )) * theta_T disc = sqrt ( b * b - 4 d0 * a * c ) denom = - b + disc denom_T = - bt + ( b * bt - 2 d0 * ( at * c + a * ct )) / disc beta = 2 d0 * c / denom slope = 4 d0 * self % p_star * beta ** 3 * 2 d0 * ( ct * denom - c * denom_T ) / denom ** 2 end function calc_dpsat_dT_iapws97_region4 module pure elemental subroutine initialize_type_iapws97_region4 ( self ) implicit none class ( type_iapws97_region4 ), intent ( inout ) :: self self % T_star = 1.0d0 ! [K] self % p_star = 1.0d6 ! [Pa] end subroutine initialize_type_iapws97_region4 pure elemental function calc_beta_iapws97_region4 ( pressure , p_star ) result ( beta ) implicit none real ( real64 ), intent ( in ) :: pressure real ( real64 ), intent ( in ) :: p_star real ( real64 ) :: beta ! Eq 29a: Transformed pressure beta beta = ( pressure / p_star ) ** 0.25d0 end function calc_beta_iapws97_region4 pure elemental function calc_vartheta_iapws97_region4 ( temperature , T_star ) result ( vartheta ) implicit none real ( real64 ), intent ( in ) :: temperature real ( real64 ), intent ( in ) :: T_star real ( real64 ) :: vartheta ! Eq 29b: Transformed temperature vartheta vartheta = temperature / T_star + n_r4 ( 9 ) / ( temperature / T_star - n_r4 ( 10 )) end function calc_vartheta_iapws97_region4 !> Saturation Pressure !> module pure elemental function calc_psat_iapws97_region4 ( self , temperature ) result ( P_sat ) implicit none class ( type_iapws97_region4 ), intent ( in ) :: self real ( real64 ), intent ( in ) :: temperature real ( real64 ) :: P_sat real ( real64 ) :: vartheta , A , B , C vartheta = calc_vartheta_iapws97_region4 ( temperature , self % T_star ) ! Eq 30 auxiliary terms A = vartheta ** 2 + n_r4 ( 1 ) * vartheta + n_r4 ( 2 ) B = n_r4 ( 3 ) * vartheta ** 2 + n_r4 ( 4 ) * vartheta + n_r4 ( 5 ) C = n_r4 ( 6 ) * vartheta ** 2 + n_r4 ( 7 ) * vartheta + n_r4 ( 8 ) ! Eq 30: ps/p* = [ 2C / (-B + sqrt...) ]&#94;4 P_sat = self % p_star * ((( 2.0d0 * C ) / ( - B + sqrt ( max (( B ** 2 - 4.0d0 * A * C ), 0.0d0 )))) ** 4 ) end function calc_psat_iapws97_region4 !> Saturation Temperature !> module pure elemental function calc_tsat_iapws97_region4 ( self , pressure ) result ( T_sat ) implicit none class ( type_iapws97_region4 ), intent ( in ) :: self real ( real64 ), intent ( in ) :: pressure real ( real64 ) :: T_sat real ( real64 ) :: beta , E , F , G , D ! beta = (p / p*)&#94;0.25 beta = calc_beta_iapws97_region4 ( pressure , self % p_star ) ! Eq 31 auxiliary terms E = beta ** 2 + n_r4 ( 3 ) * beta + n_r4 ( 6 ) F = n_r4 ( 1 ) * beta ** 2 + n_r4 ( 4 ) * beta + n_r4 ( 7 ) G = n_r4 ( 2 ) * beta ** 2 + n_r4 ( 5 ) * beta + n_r4 ( 8 ) ! D = 2G / (-F - sqrt(F&#94;2 - 4EG))x D = ( 2.0d0 * G ) / ( - F - sqrt ( max (( F ** 2 - 4.0d0 * E * G ), 0.0d0 ))) ! Ts/T* = (n10 + D - sqrt((n10 + D)&#94;2 - 4(n9 + n10*D))) / 2 T_sat = self % T_star * ( n_r4 ( 10 ) + D - sqrt ( max (( n_r4 ( 10 ) + D ) ** 2 - 4.0d0 * ( n_r4 ( 9 ) + n_r4 ( 10 ) * D ), 0.0d0 ))) / 2.0d0 end function calc_tsat_iapws97_region4 end submodule iapws97_region4","tags":"","url":"sourcefile/iapws97_region4.f90.html"},{"title":"Read Me – IAPWS","text":"IAPWS: Fortran Library for Water and Steam Properties This library provides a modern Fortran implementation of the thermodynamic properties of water and steam, based on the formulations released by the International Association for the Properties of Water and Steam (IAPWS). It is designed for scientific simulations and industrial applications requiring high-precision calculation of fluid properties. Features The library implements the following IAPWS standards:\n- IAPWS-95 : The formulation for general and scientific use (high accuracy).\n- IAPWS-IF97 : The industrial formulation for calculating the properties of water and steam (optimized for computational speed).\n- IAPWS-06 : The formulation for the properties of Ice Ih. Technical Highlights Written in Modern Fortran (F2008+ standards). Supports multiple build systems: CMake (Recommended) and Fortran Package Manager (fpm). Cross-platform compatibility (Linux, Windows). Prerequisites To build this library, you need a Fortran compiler and a build system.\n- Fortran Compiler:\n    - GNU Fortran ( gfortran )\n    - Intel OneAPI Compiler ( ifx )\n    - NVIDIA HPC SDK ( nvfortran )\n- Build Tools (either one):\n    - CMake (Version 3.25 or later) - Recommended\n    - Fortran Package Manager (fpm) Build and Installation CMake is the primary and recommended build system for installing and integrating this library. Method 1: Using CMake (Recommended)This method is best for system-wide installation or integration into C++/mixed projects. Basic Build: cmake -S . -B build\ncmake --build build Using Presets (Cross-Platform):This project provides CMake presets for different compilers ( gnu , intel , nvidia , windows-msvc ). # List available presets cmake --list-presets # Configure (e.g., using GCC Release settings) cmake --preset gnu-release # Build cmake --build --preset build-gnu-release # Test ctest --preset test-gnu-release Installation: cmake --install build --prefix /usr/local Method 2: Using the Helper Script (For Developers) A helper script FPMBuild.sh is provided to simplify the build and test process using fpm with predefined compiler flags. This is useful for rapid development and testing. Usage: ./scripts/FPMBuild.sh [ compiler ] [ build_type ] Arguments:\n- compiler : gcc , intel , nvidia , or clean - build_type : debug or release Examples: # Build and test using gfortran in debug mode ./scripts/FPMBuild.sh gcc debug # Build and test using Intel ifx in release mode ./scripts/FPMBuild.sh intel release # Clean build artifacts ./scripts/FPMBuild.sh clean Method 3: Using Fortran Package Manager (fpm) If you prefer using standard fpm commands for development: # Build the project fpm build # Run tests fpm test # Build with release optimizations fpm build --profile release Fortran static analysis IAPWS includes the FortranCheck tool developed in FTCMS. Build it with Rust 1.88 or later, Cargo, and a C compiler. The CMake integration supports single-configuration Ninja or Makefiles with gfortran or ifx . FortranCheck documentation cargo install --path tools/fortran-check --locked\ncmake --preset gnu-debug -B build/gnu-check -DIAPWS_ENABLE_FORTRAN_CHECK = ON\ncmake --build build/gnu-check --target fortran_check Set FORTRAN_CHECK_EXECUTABLE at configure time to select an executable outside PATH . In this build directory, CMake runs the check before compiling and uses the flags and definitions from its compilation database to analyze src/ . The policy permits INTENT(OUT) for result arguments and preserves published data fields and procedure names. Explicit complexity ceilings cover existing numerical kernels and public model types. Dependency errors and incomplete analysis fail the check. IAPWS policy The reports in build/gnu-check/fortran-check/ include diagnostics.sarif , metrics.json , and dependencies.dot . The GitHub Actions verification workflow uploads these reports. Documentation publishes from main after the static check, GNU Debug and Release tests, and documentation build succeed. Usage in Your Project Using CMake In your CMakeLists.txt, use find_package : find_package(IAPWS REQUIRED) add_executable(my_app main.f90) target_link_libraries(my_app PRIVATE IAPWS :: IAPWS ) Using fpm Add the following dependency to your fpm.toml: [dependencies] IAPWS = { git = \"https://github.com/ysy307/IAPWS.git\" } Unified pure-water API Construct a type_water with new_water(fluid=IF97) for industrial fluid\nproperties or new_water(fluid=IAPWS95) for scientific fluid and ice equilibrium\ncalculations. Inputs and outputs use SI units. use iso_fortran_env , only : real64 use iapws , only : type_water , type_water_state , type_water_saturation , & new_water , IF97 , IAPWS95 , LIQUID , WATER_OK , WATER_METASTABLE type ( type_water ) :: water , equilibrium type ( type_water_state ) :: state type ( type_water_saturation ) :: sat real ( real64 ) :: mu , k water = new_water ( fluid = IF97 ) call water % state_tp ( 40 0.0_real64 , 1.0e5_real64 , state ) if ( state % status == WATER_OK ) call water % transport ( state , mu = mu , conductivity = k ) call water % saturation_p ( 1.0e5_real64 , sat ) equilibrium = new_water ( fluid = IAPWS95 ) call equilibrium % state_ph ( 1.0e5_real64 , - 15000 0.0_real64 , state ) ! For a successful ice-liquid mixture, state%solid_fraction is its ice mass fraction. call equilibrium % state_tp ( 25 0.0_real64 , 1.0e5_real64 , state , phase = LIQUID , allow_metastable = . true .) ! G12-15 return values have WATER_METASTABLE status. state_tp , state_ph , state_ps , saturation_t and saturation_p are\n  pure elemental procedures and accept conformable arrays. A state reports its phase , actual formulation , status and properties . Coexisting phases are\n  marked in coexistence , with bit positions given by the phase constants.\n  A T,p coexistence query can select one endpoint with phase= . R14-08 supplies the melting and sublimation boundaries. state_tp returns\n  Ice Ih from IAPWS-06 even when the selected fluid equation is IF97. Higher\n  pressure ice can be detected, with its thermodynamic properties reported as\n  unsupported. melting_pressure(T, solid) also provides the individual R14-08\n  melting curves through ice VII. Solid-phase p,h and p,s evaluations use the IAPWS-95 constructor. They\n  combine IAPWS-95 (or G9-12 for low-temperature vapor) with IAPWS-06 at the\n  R14-08 boundary. Phase fractions at the triple point require additional\n  information. IF97's optional extend_cold_liquid=.true. applies to state_tp and uses IAPWS-95 below the IF97 lower temperature limit in\n  stable liquid states. Explicit phase and metastable requests enable G12-15 supercooled liquid\n  and the IF97 equation for metastable steam through 10 MPa. They report\n  failure outside each equation's recommended range. G9-12 extends scientific\n  vapor calculations down to 50 K in the stable vapor region. Wet IF97 or IAPWS-95 states return vapor mass fraction in quality . Mixture\n  density follows from the mass-weighted specific volume. Single-phase\n  response functions such as cp and sound speed are NaN for mixtures. transport returns dynamic viscosity in Pa·s and thermal conductivity\n  in W/(m·K) for supported fluid states. Saturation results include sigma in N/m. When using the standalone transport functions with\n  only temperature and density, the result contains the dilute-gas\n  and finite-density terms. Near a join where two IF97 regions produce the same enthalpy or entropy\n  at a fixed pressure, the inverse API can return WATER_AMBIGUOUS . Pass region= to select the required IF97 branch. At the exact critical point the common API returns WATER_SINGULAR with critical coordinates and density. A failed saturation solve very\n  close to the critical point returns WATER_NO_CONVERGENCE . CFD and thermal-hydraulic solver interface use iso_fortran_env , only : real64 use iapws , only : type_water , type_water_state , type_water_jacobian , & new_water , IAPWS95 , WATER_OK , JAC_RHO , JAC_T type ( type_water ) :: water type ( type_water_state ) :: state type ( type_water_jacobian ) :: jac real ( real64 ) :: p , h , previous_T , drho_dp , drho_dh , dT_dh water = new_water ( fluid = IAPWS95 ) p = 3.0e6_real64 h = 5.3e5_real64 previous_T = 40 0.0_real64 call water % state_ph_checked ( p , h , state , guess_T = previous_T , jac = jac ) if ( state % status == WATER_OK . and . jac % ph_available ) then drho_dp = jac % ph ( JAC_RHO , 1 ) drho_dh = jac % ph ( JAC_RHO , 2 ) dT_dh = jac % ph ( JAC_T , 2 ) end if state_tp_checked , state_ph_checked , and state_ps_checked return WATER_OK for successful equilibrium states and WATER_METASTABLE for\n  successful explicit metastable queries. On failure the property record\n  contains finite zero placeholders and the status indicates the reason.\n  Check the status before using any property. jac%tp , jac%ph , and jac%ps have columns ordered as their respective\n  input pairs, with the other input held fixed. Rows are JAC_T , JAC_P , JAC_RHO , JAC_V , JAC_H , JAC_S , and JAC_U . Check the\n  corresponding availability flag. The matrices use SI units. For equilibrium two-phase states the ph and ps matrices differentiate\n  the same boundary and mass-weighted properties used by the inverse.\n  Temperature and pressure alone leave the phase fraction undetermined.\n  The checked API fills undefined single-phase quantities such as cp and\n  sound speed with zeros in these states. Use the phase and availability flags\n  to interpret the outputs. At a phase endpoint phase_endpoint indicates\n  that the derivative follows the returned branch. IF97 region joins retain the\n  published piecewise equations and the returned properties%region_id identifies the derivative's region. Pass the previous cell iterate as guess_T= for ph and ps , and guess_rho= for tp with IAPWS-95 or IF97 region 3. Hints are optional.\n  A rejected hint falls back to the bracketed solver. A known IF97 region\n  can also be passed with region= to specify the inverse branch. The checked APIs and Jacobian procedure are pure elemental. They can be\n  called with conformable arrays or inside an OpenMP loop sharing the\n  constructed type_water . The caller supplies the guesses independently\n  for each cell. The façade owns the exact EOS evaluators privately, and the\n  public state and Jacobian types carry the solver results. The verification fixtures include IAPWS R6-95(2018) Table 7, R7-97(2012)\nregion check values, R10-06(2009) Table 6 states, R14-08 Table 3,\nG12-15 Table 5, G9-12 Table 3, R12-08 and R15-11 Tables 4 and 5, and\nSR5-05 Tables 5 and 12. The published values are rounded. The tests also compare unrounded\nresults with Python iapws==1.5.5 if installed. IEEE arithmetic is required. Official Releases and Guidelines python3 -m pip install iapws == 1 .5.5\ncmake --workflow --preset workflow-gnu-release\ncmake --build --preset build-gnu-release --target water_performance\nbuild/gnu-release/bin/water_performance OMP_NUM_THREADS = 4 OMP_PROC_BIND = close build/gnu-release/bin/water_performance --parallel The performance driver reports twelve IF97 region-3 densities and the time\nfor 120,000 density evaluations in seconds and ns/point. Compile the same driver against an earlier\nrevision with the same compiler and flags for a comparison. The accelerated\nsolver uses SR5-05 as a seed, refines against the forward pressure equation,\nand retains the bracketed solver near the critical point and as a fallback.\nThe refinement groups the pressure coefficients at the fixed temperature,\nthen evaluates pressure and its density derivative with Horner's method.\nThe SR5-05 subregion fits evaluate only their required exponents. The first\nrefinement uses a guarded Halley step and subsequent steps use Newton updates.\nThe benchmark checks every timed result against its scalar density. Its\nexplicit parallel mode uses OpenMP across independent evaluations. External water comparison The optional CoolProp test compares like formulations in SI units. HEOS::Water is used for IAPWS-95 and IF97::Water for IF97. It checks\nsingle-phase density, heat capacity, enthalpy, saturation pressure and\nendpoint densities. The HEOS comparison also checks three analytic (p,h) Jacobian entries. Each native single-phase state is inverted back\nto temperature with a tolerance of 1e-8 K . The exact critical point must\nreturn WATER_SINGULAR . Ice Ih is covered by the existing IAPWS-06\nreference fixtures and Python iapws comparison. python3 -m pip install CoolProp == 8 .1.0\ncmake --build --preset build-gnu-release --target edge_states\nctest --test-dir build/gnu-release -R coolprop_reference -V # Also compare REFPROP when the native library and water data are installed. python3 validations/compare_water.py build/gnu-release/bin/edge_states --refprop Observed on GNU Release with CoolProp 8.1.0. Values are maximum relative\ndifferences across the sampled grid. The test reports enthalpy separately\nin J/kg because it approaches zero near the triple point. Comparison Triple vicinity saturation density Critical saturation density, 0.01–1 K below Critical saturation density, 0.0001–0.001 K below IAPWS-95 / HEOS 1.08e-14 8.78e-10 1.97e-7 IF97 / CoolProp IF97 2.13e-15 3.65e-7 4.72e-4 The sampled-grid relative tolerances for ordinary, triple vicinity, critical\nand inner critical cases are respectively 5e-12 , 5e-9 , 5e-8 and 5e-6 for HEOS, and 5e-12 , 5e-12 , 5e-6 and 5e-3 for IF97.\nThese are regression limits for this grid. Three IF97 vapor-side T,p points at 605.54 Pa fall below the CoolProp IF97 pressure limit. The test\nstill requires successful native evaluation and inverse at those points.\nSee the CoolProp IF97 backend documentation . The native serial density benchmark on an Intel Core i7-14700 with GNU Release\ntook 0.0146 s for 120,000 points (122 ns/point) , the median of five runs\n(range 116–126 ns/point). The grid repeats twelve fixed points. This measures\nthe native density call plus the benchmark's checksum and verification work. Analytic derivatives Initialize the model before calling these pure elemental real64 methods. Scalar\nand conformable array arguments are supported. Temperatures are in K and\npressures in Pa. Model Method Derivative / output units IF97 and Ice Ih calc_dcp_dT(T_in, p_in, dcp_dT) At fixed pressure, J/(kg K²) IF97 and Ice Ih calc_dcp_dp(T_in, p_in, dcp_dp) At fixed temperature, J/(kg K Pa) IF97 calc_saturation_dcp_dT(T_in, dcp_dT_vap, dcp_dT_liq) Along saturation, J/(kg K²) IF97 calc_latent_heat_dT(T_in, dlatent_heat_dT) Along saturation, J/(kg K) IF97 calc_saturation_density_dT(T_in, drho_dT_vap, drho_dT_liq) Along saturation, kg/(m³ K) Fortran names are case insensitive; the Ice pressure argument is named P_in .\nBoth phase outputs are optional and ordered vapor, liquid. Saturation derivatives\ninclude the analytic pressure slope dp_sat/dT . The existing calc_saturation_drho_dT and calc_saturation_drho_dP methods retain their partial derivative meanings at fixed pressure and temperature, respectively. IF97 ordinary derivatives follow the existing region dispatcher: 243.15–2273.15 K,\n0 < p ≤ 100 MPa, with p ≤ 50 MPa above 1073.15 K. The sub-273.15 K range preserves\nthe library's existing extrapolation convention. Ice heat-capacity derivatives\nevaluate the same Gibbs expression as calc_cp for finite T and p, including\nextrapolation outside 0 < T ≤ 273.16 K and 0 ≤ p ≤ 210 MPa (also at T ≤ 0\nand p < 0). Extrapolation does not imply physical validity or guaranteed accuracy;\nnonfinite inputs return quiet NaN. Saturation derivatives accept\n273.15 ≤ T < 647.096 K, selecting regions 1/2 through 623.15 K and distinct stable\nregion-3 vapor/liquid roots above it. At region joins the derivative belongs to\nthe selected branch; the piecewise fits need not have matching derivatives. Invalid/nonfinite inputs and critical-point singularities return quiet NaN for\nthe affected element. Extremely close to the critical point, the independently\nfitted saturation pressure and region-3 equation of state can cease to bracket\nboth stable phases; saturation methods then return NaN for both phases rather\nthan an unstable root. At the critical point, saturation densities are 322 kg/m³\nand latent heat is zero; saturation heat capacity and derivatives return NaN.\nCMake builds preserve IEEE behavior even with the supplied Release presets;\nother build systems must also avoid fast-math assumptions that erase NaN checks. call water % initialize () call water % calc_dcp_dT ( 50 0.0_real64 , 3.0e6_real64 , cp_temperature_slope ) call water % calc_saturation_density_dT ( 64 0.0_real64 , & drho_dT_vap = vapor_density_slope , drho_dT_liq = liquid_density_slope ) The CTest suite checks analytic results against numerical differentiation at\nmultiple steps, phase references, region joins, optional outputs, and invalid\narray elements. The reference-data validator fails on mismatches or nonfinite\nvalues and writes logs under the build directory. Run it directly with build/gnu-debug/bin/iapws_test /absolute/path/to/validations from a scratch\nworking directory. Python 3, when available, enables an additional validator\nregression test; the library has no Python dependency. Exact CPU kernel optimizations Existing IF97 APIs also benefit without caller changes. Region-3 density solves\ncompute pressure and its density derivative together, using only the required\nHelmholtz sums. NVHPC shares one original full coefficient evaluation to retain\nbitwise compatibility. The EOS coefficients are unchanged. Saturation cp derivatives share Gibbs\ntraversals in regions 1 and 2; region 3 reuses already evaluated coefficients.\nThere are no lookup approximations, shared mutable caches, or MPI dependencies. The same-API before/after benchmark is independent of any downstream application: cmake --build build/gnu-release --target kernel_benchmark # Build this same driver against the earlier library as well, then compare: python3 benchmarks/compare_kernels.py --before /path/to/before/kernel_benchmark \\ --after build/gnu-release/bin/kernel_benchmark --repeats 7 --json results.json It rejects differing per-sample output bits before timing, alternates build\nexecution order, and records medians/ranges. The optional CMake/OpenMP check\ncompares serial results with four workers sharing a model; its source lives\noutside fpm's automatic test directory. See the HPC kernel results for measured gains, compiler-specific behavior, and reproduction details. API Document Full API documentation is available here: IAPWS FORD Document Batched IF97 evaluation Use calc_saturation_properties when several quantities are needed at the same\nsaturation temperature. It evaluates the phase pair once, sharing saturation\npressure and Gibbs coefficients (or region-3 density solves). Requested cp\npartials share the coefficient traversal in regions 1 and 2; density and\nlatent-heat derivatives reuse second-order coefficients. Unrequested phase cp\npartials do not trigger third-order work. NVHPC retains separate Gibbs/cp\ntraversals to preserve the ordinary evaluator's vector-reduction rounding.\nAll outputs are optional; the procedure is pure elemental and accepts arrays.\nExisting scalar APIs remain available with the same results. call water % calc_saturation_properties ( T , rho_vap = rho_v , & density_dT_vap = drho_v_dT , cp_vap = cp_v , dcp_dT_vap = dcp_v_dT , & latent_heat = Lv , dlatent_heat_dT = dLv_dT ) call water % calc_cp_derivatives ( T , p , dcp_dT , dcp_dp ) density_dT_vap/liq and dcp_dT_vap/liq are total derivatives along\nsaturation . drho_dT_vap/liq and drho_dP_vap/liq are fixed-pressure and\nfixed-temperature partials . Additional outputs are rho_liq , cp_liq , and\nthe liquid counterparts of the derivative outputs above. Units, validity limits,\ncritical-point values, and NaN behavior match the individual methods. No saved\nstate or shared mutable cache is introduced. calc_cp_derivatives(T_in, p_in, dcp_dT, dcp_dp) returns both ordinary partials\nwith one region dispatch and derivative evaluation (including one density solve\nin region 3), rather than repeating the work through two individual methods. The manual benchmark in benchmarks/bulk_benchmark.F90 compares the six-output\nsaturation call and ordinary cp partials in regions 1, 2, 3, and 5. It checks each\nsampled output, warms both paths, alternates execution order over seven repeats,\nand reports median/min/max CPU times and matching checksums. It lives outside test/ so fpm auto-test discovery does not include timing runs. cmake --build build/gnu-release --target bulk_benchmark\nbuild/gnu-release/bin/bulk_benchmark Timing is not a CTest pass criterion. These measurements compare the scalar and\nbulk APIs of the same build; they do not measure an application or MPI run.\nApplication speedup requires adopting the new calls at consuming call sites and\nmeasuring the full application again. For review findings, verification scope,\nand measured results, see the bulk API review . State-array APIs calc_properties_batch accepts state arrays and writes selected properties into\ncaller-owned arrays. IF97 regions 1, 2 and 5 use state-lane SIMD; IAPWS95 and ice\nalso expose the API through conservative evaluators. IF97 additionally provides calc_saturation_properties_batch . Existing scalar APIs remain available. call water % calc_properties_batch ( temperatures , pressures , rho = densities , cp = heat_capacities ) call water % calc_saturation_properties_batch ( temperatures , latent_heat = latent_heats ) See the API contract and measured performance and validation .\nSingle-state calls should continue using the scalar API; speedups depend on the model and compiler. License This project is licensed under the MIT License - see the LICENSE file for details.","tags":"","url":"page/index.html"},{"title":"license – IAPWS","text":"MIT License Copyright (c) 2025 KIKUCHI Shun Permission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions: The above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software. THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.","tags":"","url":"page/lisence.html"}]}