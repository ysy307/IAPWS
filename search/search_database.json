on_id = 3 end if liquid % p = p vapor % p = p valid = . true . end subroutine saturation_endpoints_iapws97 module procedure saturation_slope_iapws97 implicit none slope = ieee_value ( 0 d0 , ieee_quiet_nan ) if (. not . ieee_is_finite ( T )) return if ( T < 27 3.15d0 . or . T > 64 7.096d0 ) return slope = self % region4 % calc_dpsat_dT ( T ) end procedure saturation_slope_iapws97 module pure elemental function saturation_pressure_iapws97 ( self , T ) result ( p_sat ) implicit none real ( real64 ) :: p_sat class ( type_iapws97 ), intent ( in ) :: self real ( real64 ), intent ( in ) :: T p_sat = ieee_value ( 0 d0 , ieee_quiet_nan ) if (. not . ieee_is_finite ( T )) return if ( T < 27 3.15d0 . or . T > 64 7.096d0 ) return p_sat = self % region4 % calc_psat ( T ) if ( T == 64 7.096d0 ) p_sat = 2 2.064d6 end function saturation_pressure_iapws97 module pure elemental function saturation_temperature_iapws97 ( self , p ) result ( T_sat ) implicit none real ( real64 ) :: T_sat class ( type_iapws97 ), intent ( in ) :: self real ( real64 ), intent ( in ) :: p T_sat = ieee_value ( 0 d0 , ieee_quiet_nan ) if (. not . ieee_is_finite ( p )) return if ( p < self % region4 % calc_psat ( 27 3.15d0 ) . or . p > 2 2.064d6 ) return T_sat = max ( 27 3.15d0 , self % region4 % calc_tsat ( p )) if ( p == 2 2.064d6 ) T_sat = 64 7.096d0 end function saturation_temperature_iapws97 !> Batched saturation values and derivatives. density_dT is the total !> derivative along saturation; drho_dT and drho_dP are partials. module pure elemental subroutine calc_saturation_properties_iapws97 ( self , T_in , rho_vap , rho_liq , cp_vap , & cp_liq , drho_dT_vap , drho_dT_liq , drho_dP_vap , drho_dP_liq , density_dT_vap , density_dT_liq , dcp_dT_vap , & dcp_dT_liq , latent_heat , dlatent_heat_dT ) implicit none class ( type_iapws97 ), intent ( in ) :: self real ( real64 ), intent ( in ) :: T_in real ( real64 ), intent ( out ), optional :: rho_vap , rho_liq , cp_vap , cp_liq , drho_dT_vap , drho_dT_liq , & drho_dP_vap , drho_dP_liq , density_dT_vap , density_dT_liq , dcp_dT_vap , dcp_dT_liq , latent_heat , & dlatent_heat_dT type ( saturation_phase ) :: vap , liq real ( real64 ) :: slope ! Only heat-capacity derivatives require third-order EOS terms. call saturation_state ( self , T_in , vap , liq , slope , & present ( dcp_dT_vap ), present ( dcp_dT_liq )) if ( present ( rho_vap )) rho_vap = vap % rho if ( present ( rho_liq )) rho_liq = liq % rho if ( present ( cp_vap )) cp_vap = vap % cp if ( present ( cp_liq )) cp_liq = liq % cp if ( present ( drho_dT_vap )) drho_dT_vap = vap % rho_T if ( present ( drho_dT_liq )) drho_dT_liq = liq % rho_T if ( present ( drho_dP_vap )) drho_dP_vap = vap % rho_p if ( present ( drho_dP_liq )) drho_dP_liq = liq % rho_p if ( present ( density_dT_vap )) density_dT_vap = vap % rho_T + vap % rho_p * slope if ( present ( density_dT_liq )) density_dT_liq = liq % rho_T + liq % rho_p * slope if ( present ( dcp_dT_vap )) dcp_dT_vap = vap % cp_T + vap % cp_p * slope if ( present ( dcp_dT_liq )) dcp_dT_liq = liq % cp_T + liq % cp_p * slope if ( present ( latent_heat )) latent_heat = vap % h - liq % h if ( present ( dlatent_heat_dT )) dlatent_heat_dT = ( vap % cp - liq % cp ) + ( vap % h_p - liq % h_p ) * slope end subroutine module pure elemental subroutine calc_cp_derivatives_iapws97 ( self , T_in , p_in , dcp_dT , dcp_dp ) implicit none class ( type_iapws97 ), intent ( in ) :: self real ( real64 ), intent ( in ) :: T_in , p_in real ( real64 ), intent ( out ) :: dcp_dT , dcp_dp call cp_derivatives ( self , T_in , p_in , dcp_dT , dcp_dp ) end subroutine !> Initialize the IAPWS-97 model instance. !> Initializes all sub-region handlers and auxiliary equations. module pure elemental subroutine initialize_type_iapws97 ( self ) implicit none !> IAPWS-97 instance class ( type_iapws97 ), intent ( inout ) :: self call self % auxiliary % initialize () call self % region1 % initialize () call self % region2 % initialize () call self % region3 % initialize () call self % region4 % initialize () call self % region5 % initialize () end subroutine initialize_type_iapws97 !> Determine the IAPWS-97 region for a given temperature and pressure. !> Checks validity limits and boundaries between regions (Saturation, B23). module pure elemental function get_region_iapws97 ( self , T_in , p_in ) result ( region_id ) implicit none !> IAPWS-97 instance class ( type_iapws97 ), intent ( in ) :: self !> Temperature [K] real ( real64 ), intent ( in ) :: T_in !> Pressure [Pa] real ( real64 ), intent ( in ) :: p_in !> Region ID result integer ( int32 ) :: region_id real ( real64 ) :: p_boundary ! 1. Global Validity Check ! Region 1, 2, 3: p <= 100 MPa ! Region 5: p <= 50 MPa -> Checked individually ! T >= 243.15 K region_id = IAPWS97_INVALID if (. not . ieee_is_finite ( T_in ) . or . . not . ieee_is_finite ( p_in )) return if ( p_in <= 0.0d0 . or . p_in > 10 0.0d6 . or . & T_in < 24 3.15d0 . or . T_in > 227 3.15d0 ) then region_id = IAPWS97_INVALID return end if ! 2. Hierarchical determination by temperature (Based on Fig. 1) ! --- High Temperature (Region 5) --- ! 1073.15 K < T <= 2273.15 K if ( T_in > 107 3.15d0 ) then if ( p_in <= 5 0.0d6 ) then region_id = IAPWS97_REGION_5 else region_id = IAPWS97_INVALID ! Region 5 max P is 50MPa end if return end if ! --- Region 2 Only Area --- ! 863.15 K < T <= 1073.15 K ! This temp range is Region 2 for all pressures up to 100MPa if ( T_in > 86 3.15d0 ) then region_id = IAPWS97_REGION_2 return end if ! --- Boundary between Region 2 and Region 3 --- ! 623.15 K < T <= 863.15 K ! Boundary: B23 equation (Eq. 5) if ( T_in > 62 3.15d0 ) then p_boundary = self % auxiliary % calc_p_boundary ( T_in ) if ( p_in > p_boundary ) then region_id = IAPWS97_REGION_3 else region_id = IAPWS97_REGION_2 end if return end if ! --- Boundary between Region 1 and Region 2 (Saturation Curve) --- ! 273.15 K <= T <= 623.15 K ! Boundary: Saturation pressure equation (Eq. 30) p_boundary = self % region4 % calc_psat ( T_in ) if ( 