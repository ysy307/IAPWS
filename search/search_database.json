 , gamma_t , & gamma_pp , gamma_tt , gamma_pt , cp_tt , cp_ttt , cp_ttp ) implicit none !> Dimensionless temperature \\tau real ( real64 ), intent ( in ) :: tau !> Dimensionless pressure \\pi real ( real64 ), intent ( in ) :: pi !> Resulting gamma and derivatives real ( real64 ), intent ( inout ) :: gamma , gamma_p , gamma_t real ( real64 ), intent ( inout ) :: gamma_pp , gamma_tt , gamma_pt real ( real64 ), intent ( inout ) :: cp_tt , cp_ttt , cp_ttp real ( real64 ) :: cp_tau ( - 44 : 17 ), cp_term integer ( int32 ) :: i , k real ( real64 ) :: base_pi , base_tau , inv_pi , inv_tau real ( real64 ) :: powers_pi ( PI_EXP_LO : PI_EXP_HI ) real ( real64 ) :: powers_tau ( TAU_EXP_LO : TAU_EXP_HI ) real ( real64 ) :: I_val , J_val , pp , pt base_pi = 7.1d0 - pi base_tau = tau - 1.222d0 ! Build power table for base_pi: indices -2..32 powers_pi ( 0 ) = 1.0d0 powers_pi ( 1 ) = base_pi do k = 2 , PI_EXP_HI powers_pi ( k ) = powers_pi ( k - 1 ) * base_pi end do inv_pi = 1.0d0 / base_pi powers_pi ( - 1 ) = inv_pi powers_pi ( - 2 ) = inv_pi * inv_pi ! Build power table for base_tau: indices -43..17 powers_tau ( 0 ) = 1.0d0 powers_tau ( 1 ) = base_tau do k = 2 , TAU_EXP_HI powers_tau ( k ) = powers_tau ( k - 1 ) * base_tau end do inv_tau = 1.0d0 / base_tau powers_tau ( - 1 ) = inv_tau do k = - 2 , TAU_EXP_LO , - 1 powers_tau ( k ) = powers_tau ( k + 1 ) * inv_tau end do ! The derivative evaluator historically used division for negative ! powers. Keep it rather than substituting reciprocal products. cp_tau ( 0 : 17 ) = powers_tau ( 0 : 17 ) do k = - 1 , - 44 , - 1 cp_tau ( k ) = cp_tau ( k + 1 ) / base_tau end do cp_tt = 0 d0 ; cp_ttt = 0 d0 ; cp_ttp = 0 d0 ! Accumulate all 6 sums in a single loop gamma = 0.0d0 gamma_p = 0.0d0 gamma_t = 0.0d0 gamma_pp = 0.0d0 gamma_tt = 0.0d0 gamma_pt = 0.0d0 do i = 1 , N1_terms I_val = real ( I_r1 ( i ), real64 ) J_val = real ( J_r1 ( i ), real64 ) pp = powers_pi ( I_r1 ( i )) pt = powers_tau ( J_r1 ( i )) gamma = gamma + n_r1 ( i ) * pp * pt gamma_p = gamma_p + & ( - n_r1 ( i )) * I_val * powers_pi ( I_r1 ( i ) - 1 ) * pt gamma_t = gamma_t + & n_r1 ( i ) * pp * J_val * powers_tau ( J_r1 ( i ) - 1 ) gamma_pp = gamma_pp + & n_r1 ( i ) * I_val * ( I_val - 1.0d0 ) * powers_pi ( I_r1 ( i ) - 2 ) * pt gamma_tt = gamma_tt + & n_r1 ( i ) * pp * J_val * ( J_val - 1.0d0 ) * powers_tau ( J_r1 ( i ) - 2 ) gamma_pt = gamma_pt + & ( - n_r1 ( i )) * I_val * powers_pi ( I_r1 ( i ) - 1 ) * J_val * powers_tau ( J_r1 ( i ) - 1 ) if ( J_r1 ( i ) /= 0 . and . J_r1 ( i ) /= 1 ) then cp_term = n_r1 ( i ) * J_val * ( J_val - 1 d0 ) cp_tt = cp_tt + cp_term * powers_pi ( I_r1 ( i )) * cp_tau ( J_r1 ( i ) - 2 ) if ( J_r1 ( i ) /= 2 ) cp_ttt = cp_ttt + cp_term * ( J_val - 2 d0 ) * powers_pi ( I_r1 ( i )) * cp_tau ( J_r1 ( i ) - 3 ) if ( I_r1 ( i ) /= 0 ) cp_ttp = cp_ttp - cp_term * I_val * powers_pi ( I_r1 ( i ) - 1 ) * cp_tau ( J_r1 ( i ) - 2 ) end if end do end subroutine calc_gamma_all_cp_region1","tags":"","url":"proc/calc_gamma_all_cp_region1.html"},{"title":"calc_gamma_all_region1 – IAPWS","text":"pure subroutine calc_gamma_all_region1(tau, pi, gamma, gamma_p, gamma_t, gamma_pp, gamma_tt, gamma_pt) Calculate all dimensionless Gibbs free energy derivatives for Region 1\nin a single pass, using pre-computed power tables to eliminate\nrepeated integer exponentiation. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: tau Dimensionless temperature real(kind=real64), intent(in) :: pi Dimensionless pressure real(kind=real64), intent(inout) :: gamma Resulting gamma and derivatives real(kind=real64), intent(inout) :: gamma_p Resulting gamma and derivatives real(kind=real64), intent(inout) :: gamma_t Resulting gamma and derivatives real(kind=real64), intent(inout) :: gamma_pp real(kind=real64), intent(inout) :: gamma_tt real(kind=real64), intent(inout) :: gamma_pt Called by proc~~calc_gamma_all_region1~~CalledByGraph proc~calc_gamma_all_region1 calc_gamma_all_region1 proc~calc_gamma_iapws97_region1 calc_gamm