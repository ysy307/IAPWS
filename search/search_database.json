CH_TILE , size ( T_in ) - base + 1 ) !$omp simd do lane = 1 , width tau ( lane ) = self % T_star / T_in ( base + lane - 1 ); pi ( lane ) = P_in ( base + lane - 1 ) / self % p_star y ( lane ) = tau ( lane ); iy ( lane ) = 1 d0 / tau ( lane ) xp ( lane , 0 ) = 1 d0 ; xp ( lane , 1 ) = pi ( lane ); xp ( lane , - 1 ) = 1 d0 / pi ( lane ) yp ( lane , 0 ) = 1 d0 ; yp ( lane , 1 ) = y ( lane ) yp ( lane , - 1 ) = 1 d0 / y ( lane ) t0 ( lane , 0 ) = 1 d0 ; t0 ( lane , 1 ) = tau ( lane ); t0 ( lane , - 1 ) = iy ( lane ) ideal ( lane , 1 ) = log ( pi ( lane )); ideal ( lane , 2 ) = 0 d0 ; ideal ( lane , 3 ) = 0 d0 end do do k = 2 , 3 !$omp simd do lane = 1 , width xp ( lane , k ) = xp ( lane , k - 1 ) * pi ( lane ) end do end do do k = 2 , 9 !$omp simd do lane = 1 , width yp ( lane , k ) = yp ( lane , k - 1 ) * y ( lane ) end do end do do k = 2 , 2 !$omp simd do lane = 1 , width t0 ( lane , k ) = t0 ( lane , k - 1 ) * tau ( lane ) end do end do do k = - 2 , - 5 , - 1 !$omp simd do lane = 1 , width t0 ( lane , k ) = t0 ( lane , k + 1 ) * iy ( lane ) end do end do do term = 1 , N05_terms jv = real ( J0_r5 ( term ), real64 ) !$omp simd do lane = 1 , width ideal ( lane , 1 ) = ideal ( lane , 1 ) + n0_r5 ( term ) * t0 ( lane , J0_r5 ( term )) ideal ( lane , 2 ) = ideal ( lane , 2 ) + n0_r5 ( term ) * jv * t0 ( lane , J0_r5 ( term ) - 1 ) ideal ( lane , 3 ) = ideal ( lane , 3 ) + n0_r5 ( term ) * jv * ( jv - 1 d0 ) * t0 ( lane , J0_r5 ( term ) - 2 ) end do end do sums = 0 d0 do term = 1 , Nr5_terms iv = real ( Ir_r5 ( term ), real64 ); jv = real ( Jr_r5 ( term ), real64 ) !$omp simd private(pp,pt) do lane = 1 , width pp = xp ( lane , Ir_r5 ( term )); pt = yp ( lane , Jr_r5 ( term )) sums ( lane , 1 ) = sums ( lane , 1 ) + nr_r5 ( term ) * pp * pt sums ( lane , 2 ) = sums ( lane , 2 ) + nr_r5 ( term ) * iv * xp ( lane , Ir_r5 ( term ) - 1 ) * pt sums ( lane , 3 ) = sums ( lane , 3 ) + nr_r5 ( term ) * jv * pp * yp ( lane , Jr_r5 ( term ) - 1 ) sums ( lane , 4 ) = sums ( lane , 4 ) +