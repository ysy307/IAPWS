e in Pa. pure elemental function sublimation_pressure ( T ) result ( p ) implicit none real ( real64 ) :: p real ( real64 ), intent ( in ) :: T real ( real64 ) :: theta p = ieee_value ( 0 d0 , ieee_quiet_nan ) if (. not . ieee_is_finite ( T )) return if ( T < 50 d0 . or . T > triple_T ) return theta = T / triple_T p = triple_p * exp (( - 2 1.2144006d0 * theta ** 0.00333333333d0 + & 2 7.3203819d0 * theta ** 1.20666667d0 - 6.10598130d0 * theta ** 1.70333333d0 ) / theta ) if ( T == triple_T ) p = triple_p end function sublimation_pressure ! dp/dT on the Ice Ih melting and sublimation curves of R14-08. pure elemental function ice_ih_melting_slope ( T ) result ( slope ) implicit none real ( real64 ) :: slope real ( real64 ), intent ( in ) :: T real ( real64 ) :: theta slope = ieee_value ( 0 d0 , ieee_quiet_nan ) if (. not . ieee_is_finite ( T )) return if ( T < 25 1.165d0 . or . T > triple_T ) return theta = T / triple_T slope = - triple_p / triple_T * ( 3 d0 * 119539 3.37d0 * theta ** 2 + & 2 5.75d0 * 8081 8.3159d0 * theta ** 2 4.75d0 + 10 3.75d0 * 333 8.26860d0 * theta ** 10 2.75d0 ) end function ice_ih_melting_slope pure elemental function sublimation_slope ( T ) result ( slope ) implicit none real ( real64 ) :: slope real ( real64 ), intent ( in ) :: T real ( real64 ) :: theta slope = ieee_value ( 0 d0 , ieee_quiet_nan ) if (. not . ieee_is_finite ( T )) return if ( T < 50 d0 . or . T > triple_T ) return theta = T / triple_T slope = sublimation_pressure ( T ) / ( triple_T * theta ** 2 ) * & ( - 2 1.2144006d0 * ( - 0.99666666667d0 ) * theta ** 0.00333333333d0 + & 2 7.3203819d0 * 0.20666667d0 * theta ** 1.20666667d0 - & 6.10598130d0 * 0.70333333d0 * theta ** 1.70333333d0 ) end function sublimation_slope end module module_water_phase_boundaries","tags":"","url":"sourcefile/water_phase_boundaries.f90.html"},{"title":"iapws97_region1.F90 – IAPWS","text":"This file depends on sourcefile~~iapws97_region1.f90~~EfferentGraph sourcefile~iapws97_region1.f90 iapws97_region1.F90 