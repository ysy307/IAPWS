l ( real64 ) :: xp ( IAPWS_BATCH_TILE , - 1 : 24 ), yp ( IAPWS_BATCH_TILE , - 2 : 58 ) real ( real64 ) :: t0 ( IAPWS_BATCH_TILE , - 7 : 3 ), sums ( IAPWS_BATCH_TILE , 6 ), ideal ( IAPWS_BATCH_TILE , 3 ) real ( real64 ) :: tau ( IAPWS_BATCH_TILE ), pi ( IAPWS_BATCH_TILE ), y ( IAPWS_BATCH_TILE ), iy ( IAPWS_BATCH_TILE ) real ( real64 ) :: iv , jv , pp , pt , rt , r_pstar , val_g , val_gp , val_gt , val_gpp , val_gtt , val_gpt #endif if ( size ( P_in ) /= size ( T_in ) . or . size ( coef , 1 ) /= size ( T_in ) . or . size ( coef , 2 ) /= 6 ) & error stop 'IAPWS batch: Gibbs coefficient shape' #if defined(__NVCOMPILER) ! Preserve this compiler's existing within-state vector reductions. do j = 1 , size ( T_in ) call self % calc_gamma ( T_in ( j ), P_in ( j ), g ) coef ( j , :) = [ g % g , g % g_p , g % g_t , g % g_pp , g % g_tt , g % g_pt ] end do #else if ( size ( T_in ) < 4 ) then do j = 1 , size ( T_in ) call self % calc_gamma ( T_in ( j ), P_in ( j ), g ) coef ( j , :) = [ g % g , g % g_p , g % g_t , g % g_pp , g % g_tt , g % g_pt ] end do return end if do base = 1 , size ( T_in ), IAPWS_BATCH_TILE width = min ( IAPWS_BATCH_TILE , size ( T_in ) - base + 1 ) !$omp simd do lane = 1 , width tau ( lane ) = self % T_star / T_in ( base + lane - 1 ); pi ( lane ) = P_in ( base + lane - 1 ) / self % p_star y ( lane ) = tau ( lane ) - 0.5d0 ; iy ( lane ) = 1 d0 / tau ( lane ) xp ( lane , 0 ) = 1 d0 ; xp ( lane , 1 ) = pi ( lane ); xp ( lane , - 1 ) = 1 d0 / pi ( lane ) yp ( lane , 0 ) = 1 d0 ; yp ( lane , 1 ) = y ( lane ) yp ( lane , - 1 ) = 1 d0 / y ( lane ) t0 ( lane , 0 ) = 1 d0 ; t0 ( lane , 1 ) = tau ( lane ); t0 ( lane , - 1 ) = iy ( lane ) ideal ( lane , 1 ) = log ( pi ( lane )); ideal ( lane , 2 ) = 0 d0 ; ideal ( lane , 3 ) = 0 d0 end do !$omp simd do lane = 1 , width yp ( lane , - 2 ) = yp ( lane , - 1 ) * yp ( lane , - 1 ) end do do k = 2 , 24 !$omp simd do lane = 1 , width xp ( lane , k ) = xp ( lane , k - 1 ) * pi ( lane ) end do end do do k = 2 , 58 !$omp simd d