nt from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code module pure elemental subroutine calc_pressure_pair_iapws97_region3 ( self , T_in , rho_in , p , p_rho ) implicit none class ( type_iapws97_region3 ), intent ( in ) :: self real ( real64 ), intent ( in ) :: T_in , rho_in real ( real64 ), intent ( out ) :: p , p_rho #if defined(__NVCOMPILER) type ( type_iapws_helmholtz_property ) :: f ! Its six-sum and two-sum vector reductions have different rounding. ! Reuse one original phi evaluation for p and p_rho rather than two; ! keep the root solver's pressure values and decisions bitwise stable. call self % calc_phi ( self % T_c / T_in , rho_in / self % rho_c , f ) call self % calc_p ( T_in , rho_in , p , f ) call self % calc_p_rho ( T_in , rho_in , p_rho , f ) #else real ( real64 ) :: tau , delta , inv_delta , fd , fdd , iv , term_tau real ( real64 ) :: pd ( DELTA_EXP_LO : DELTA_EXP_HI ), pt ( 0 : TAU_EXP_HI ) integer :: i , k tau = self % T_c / T_in delta = rho_in / self % rho_c pd ( 0 ) = 1 d0 ; pd ( 1 ) = delta do k = 2 , DELTA_EXP_HI pd ( k ) = pd ( k - 1 ) * delta end do inv_delta = 1 d0 / delta pd ( - 1 ) = inv_delta ; pd ( - 2 ) = inv_delta * inv_delta pt ( 0 ) = 1 d0 ; pt ( 1 ) = tau do k = 2 , TAU_EXP_HI pt ( k ) = pt ( k - 1 ) * tau end do fd = n_r3 ( 1 ) * inv_delta fdd = - n_r3 ( 1 ) * inv_delta * inv_delta do i = 2 , N3_terms iv = real ( I_r3 ( i ), real64 ) term_tau = pt ( J_r3 ( i )) fd = fd + n_r3 ( i ) * iv * pd ( I_r3 ( i ) - 1 ) * term_tau fdd = fdd + n_r3 ( i ) * iv * ( iv - 1 d0 ) * pd ( I_r3 ( i ) - 2 ) * term_tau end do p = rho_in * self % R * T_in * delta * fd p_rho = self % R * T_in * ( 2 d0 * delta * fd + delta ** 2 * fdd ) #endif end subroutine calc_pressure_pair