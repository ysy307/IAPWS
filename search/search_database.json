n 1 (Liquid water) identifier integer ( int32 ), parameter :: IAPWS97_REGION_1 = 1 !> Region 2 (Steam) identifier integer ( int32 ), parameter :: IAPWS97_REGION_2 = 2 !> Region 3 (Critical / Supercritical) identifier integer ( int32 ), parameter :: IAPWS97_REGION_3 = 3 !> Region 5 (High temperature) identifier integer ( int32 ), parameter :: IAPWS97_REGION_5 = 5 !> Global maximum temperature limit [K] real ( real64 ), parameter :: IAPWS97_LIMIT_T_MAX = 227 3.15d0 !> Global maximum pressure limit [Pa] real ( real64 ), parameter :: IAPWS97_LIMIT_P_MAX = 10 0.0d6 !> Region 5 minimum temperature [K] real ( real64 ), parameter :: IAPWS97_R5_T_MIN = 107 3.15d0 !> Region 5 maximum pressure [Pa] real ( real64 ), parameter :: IAPWS97_R5_P_MAX = 5 0.0d6 ! Phase data shared by saturation values, partials, and total derivatives. type :: saturation_phase real ( real64 ) :: rho , cp , h , rho_T , rho_p , cp_T , cp_p , h_p end type contains module pure elemental subroutine metastable_vapor_iapws97 ( self , T , p , property , valid ) implicit none class ( type_iapws97 ), intent ( in ) :: self real ( real64 ), intent ( in ) :: T , p type ( type_iapws_property ), intent ( inout ) :: property logical , intent ( out ) :: valid type ( type_iapws_gibbs_coefficient ) :: g real ( real64 ) :: Ts , hf , hg , h valid = . false . if (. not . ieee_is_finite ( T ) . or . . not . ieee_is_finite ( p )) return if ( T < 27 3.16d0 . or . p < 61 1.657d0 . or . p > 10 d6 ) return Ts = self % region4 % calc_tsat ( p ) if ( T > Ts ) return call self % region2 % calc_gamma_metastable ( T , p , g ) h = g % g - T * g % g_t call self % region1 % calc_h ( Ts , p , hf ) call self % region2 % calc_h ( Ts , p , hg ) if ( h < hg - 0.05d0 * ( hg - hf )) return if ( g % g_p <= 0 d0 . or . g % g_pp >= 0 d0 . or . g % g_tt >= 0 d0 ) return if ( g % g_pp - g % g_pt ** 2 / g % g_tt >= 0 d0 ) return call self % region2 % project_properties ( T , p , property , g ) property % region_id = 2 valid = . true . end subroutine