utine solve_density_iapws95(self, T_in, P_in, rho, guess_rho) Implementation → Arguments Type Intent Optional Attributes Name class( type_iapws95 ), intent(in) :: self real(kind=real64), intent(in) :: T_in real(kind=real64), intent(in) :: P_in real(kind=real64), intent(out) :: rho real(kind=real64), intent(in), optional :: guess_rho","tags":"","url":"interface/solve_density_iapws95.html"},{"title":"calc_gamma0_all_region5 – IAPWS","text":"pure subroutine calc_gamma0_all_region5(tau, pi, g0, g0_t, g0_tt) Calculate all ideal-gas (gamma0) derivatives for Region 5\nusing a pre-computed power table for tau. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: tau real(kind=real64), intent(in) :: pi real(kind=real64), intent(inout) :: g0 real(kind=real64), intent(inout) :: g0_t real(kind=real64), intent(inout) :: g0_tt Called by proc~~calc_gamma0_all_region5~~CalledByGraph proc~calc_gamma0_all_region5 calc_gamma0_all_region5 proc~calc_gamma_iapws97_region5 calc_gamma_iapws97_region5 proc~calc_gamma_iapws97_region5->proc~calc_gamma0_all_region5 interface~calc_gamma_iapws97_region5 type_iapws97_region5%calc_gamma_iapws97_region5 interface~calc_gamma_iapws97_region5->proc~calc_gamma_iapws97_region5 proc~calc_gamma_batch_iapws97_region5 calc_gamma_batch_iapws97_region5 proc~calc_gamma_batch_iapws97_region5->interface~calc_gamma_iapws97_region5 interface~calc_gamma_batch_iapws97_region5 type_iapws97_region5%calc_gamma_batch_iapws97_region5 interface~calc_gamma_batch_iapws97_region5->proc~calc_gamma_batch_iapws97_region5 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure subroutine calc_gamma0_all_region5 ( tau , pi , g0 , g0_t , g0_tt ) implicit none real ( real64 ), intent ( in ) :: tau , pi real ( real64 ), intent ( inout ) :: g0 , g0_t , g0_tt integer ( int32 ) :: i , k real ( real64 ) :: powers_tau ( TAU0_EXP_LO : TAU0_EXP_HI ) real ( real64 ) :: inv_tau , J_val ! Build power table for tau: indices -5..2 powers_tau ( 0 ) = 1.0d0 powers_tau ( 1 ) = tau powers_tau ( 2 ) = tau * tau inv_tau = 1.0d0 / tau powers_tau ( - 1 ) = inv_tau do k = - 2 , TAU0_EXP_LO , - 1 powers_tau ( k ) = powers_tau ( k + 1 ) * inv_tau end do g0 = log ( pi ) g0_t = 0.0d0 g0_tt = 0.0d0 do i = 1 , N05_terms J_val = real ( J0_r5 ( i ), real64 ) g0 = g0 + n0_r5 ( i ) * powers_tau ( J0_r5 ( i )) g0_t = g0_t + n0_r5 ( i ) * J_val * powers_tau ( J0_r5 ( i ) - 1 ) g0_tt = g0_tt + n0_r5 ( i ) * J_val * ( J_val - 1.0d0 ) * powers_tau ( J0_r5 ( i ) - 2 ) end do end subroutine calc_gamma0_all_region5","tags":"","url":"proc/calc_gamma0_all_region5.html"},{"title":"calc_gammar_all_region5 – IAPWS","text":"pure subroutine calc_gammar_all_region5(tau, pi, gr, gr_p, gr_t, gr_pp, gr_tt, gr_pt) Calculate all residual (gammar) derivatives for Region 5\nusing pre-computed power tables for pi and tau. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: tau real(kind=real64), intent(in) :: pi real(kind=real64), intent(inout) :: gr real(kind=real64), intent(inout) :: gr_p real(kind=real64), intent(inout) :: gr_t real(kind=real64), intent(inout) :: gr_pp real(kind=real64), intent(inout) :: gr_tt real(kind=real64), intent(inout) :: gr_pt Called by proc~~calc_gammar_all_region5~~CalledByGraph proc~calc_gammar_all_region5 calc_gammar_all_region5 proc~calc_gamma_iapws97_region5 calc_gamma_iapws97_